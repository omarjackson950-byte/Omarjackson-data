# ─── Nuggets Memory Pro — Environment Variables ───────────────────────────────
# Copy this file to .env and fill in the values you need.

# ── Storage paths (optional — defaults to ~/.nuggets-memory-pro/) ─────────────
# NUGGETS_STORE_PATH=/path/to/store.json
# NUGGETS_AUDIT_PATH=/path/to/audit.ndjson
# NUGGETS_NUDGE_PATH=/path/to/nudge.json
# NUGGETS_CONFIG_DIR=/path/to/config/dir

# ── Backend (optional — defaults to hosted Nuggets Pro API) ───────────────────
# NUGGETS_API_BASE=https://api.nuggets-memory.pro

# ── Stripe keys (required if self-hosting the payment backend) ─────────────────
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_PRICE_INDIVIDUAL=price_...
# STRIPE_PRICE_TEAM=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── Supabase (required if self-hosting the cloud sync backend) ────────────────
# NUGGETS_SUPABASE_URL=https://your-project.supabase.co
# NUGGETS_SUPABASE_KEY=your-anon-or-service-key
